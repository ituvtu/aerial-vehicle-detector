__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv/

# Python & uv
.pytest_cache/
.ruff_cache/

# OS / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
.env

# Raw heavy media & working caches
data/raw_videos/*.mp4
data/raw_videos/*.mov
data/raw_videos/*.avi
data/images/*.jpg
data/images/*.png
data/*.zip
data/images/
data/raw_videos/

# CVAT local working directories & artifacts
data/cvat/
data/cvat/backups/
artifacts/*.zip
colab_results_bundle*.zip
